# Copy to .env and fill in. Never commit the real .env.

PORT=5000
# Session times are Indian time
TZ=Asia/Kolkata

# MongoDB Atlas connection string (put the database name before the "?")
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/unfazed?retryWrites=true&w=majority
# Long random string used to sign logins
JWT_SECRET=change-me

# The frontend's address (comma-separate several). Used for links in emails and CORS.
FRONTEND_URL=http://localhost:5173
# This API's public address, used for invoice links in emails
API_PUBLIC_URL=http://localhost:5000

# SMTP (e.g. Brevo)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Video sessions (Daily.co). Without it, sessions fall back to Jitsi.
DAILY_API_KEY=

# Razorpay (test keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
